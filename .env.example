# Copy this file to .env.local and fill in the values (never commit .env.local).
# In Vercel: Project -> Settings -> Environment Variables, add the same names.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key. SECRET: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public address used in links inside (simulated) messages.
# On Vercel this defaults to the production domain.
# SITE_URL=https://your-domain.co.ke

# Optional (demo): really send client WhatsApps via the Twilio WhatsApp Sandbox.
# Recipients must first send the sandbox "join <code>" message. Leave empty to keep simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
