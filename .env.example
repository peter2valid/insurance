# Copy this file to .env.local and fill in the values (never commit .env.local).
# In Vercel: Project -> Settings -> Environment Variables, add the same names.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key. SECRET: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: the public address used in links inside (simulated) messages.
# On Vercel this defaults to the production domain.
# SITE_URL=https://your-domain.co.ke

# Optional (demo): really send client WhatsApps via Twilio.
# Free-form messages only reach people who messaged your Twilio WhatsApp number in
# the last 24 hours (sandbox: who sent the "join <code>" message). Leave empty to keep simulated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# Optional: admin alerts on WhatsApp go to the agency number in lib/brand.ts.
# Override with another number (digits only, e.g. 254712345678).
# ADMIN_WHATSAPP=

# Optional: real email through Resend (https://resend.com). Verify your domain
# in Resend first. Leave empty to keep emails simulated in Messages.
RESEND_API_KEY=
EMAIL_FROM="Beacon Cover <hello@your-domain.co.ke>"
# Where the broker's own email alerts go.
ADMIN_EMAIL=

# Optional: protect /admin with a password. Leave empty for an open demo admin.
ADMIN_PASSWORD=

# Runs the automations hourly (Netlify scheduled function / Vercel cron call
# /api/cron with this secret). Any long random string.
CRON_SECRET=

# Signs client sessions and the links in WhatsApp/email messages. Any long random
# string; changing it signs everyone out and old message links stop opening.
# If empty, CRON_SECRET is used.
SESSION_SECRET=
